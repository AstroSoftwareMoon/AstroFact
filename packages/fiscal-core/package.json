{
  "name": "@astrofact/fiscal-core",
  "version": "0.6.0",
  "description": "Núcleo fiscal de AstroFact: registros de facturación, huella, encadenado, QR, firma XAdES y SOAP VERI*FACTU. Sin dependencias de UI.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@xmldom/xmldom": "^0.9.8",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "xadesjs": "^3.1.0",
    "xmldsigjs": "^3.1.0",
    "xml-core": "^3.1.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
