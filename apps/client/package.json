{
  "name": "@astrofact/client",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(E2E: pnpm --filter @astrofact/client e2e)\"",
    "e2e": "vite build && node e2e/run.cjs",
    "tauri": "tauri",
    "build:web": "tsc --noEmit && vite build --mode web",
    "e2e:servidor": "vite build --mode web && node e2e/servidor.cjs"
  },
  "dependencies": {
    "@astrofact/db": "workspace:*",
    "@astrofact/fiscal-core": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sql.js": "^1.13.0",
    "@astrofact/pdf": "workspace:*",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@astrofact/informes": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.0",
    "@types/sql.js": "^1.4.9",
